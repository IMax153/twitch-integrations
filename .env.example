# Cloudflare Access: the GitHub OAuth application that signs the Broadcaster in.
CLOUDFLARE_ACCESS_GITHUB_CLIENT_ID=
CLOUDFLARE_ACCESS_GITHUB_CLIENT_SECRET=

# The one email the Access policy admits; also the simulated identity under `alchemy dev`.
TWITCH_BROADCASTER_EMAIL=

# Provider Credentials: one developer application per Provider, shared by local and production.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# The secret Twitch signs every EventSub webhook message with. Choose any ASCII string of 10 to 100 characters.
TWITCH_EVENTSUB_SECRET=
